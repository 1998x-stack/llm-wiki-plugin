%% ─────────────────────────────────────────────
%%  COMMAND → SCRIPT EDGES  (solid = calls)
%% ─────────────────────────────────────────────

C_INGEST --> PY_BM25
C_INGEST --> PY_LINT

C_LOOP --> SH_LOOP
C_LOOP -.->|delegates| C_INGEST

C_QWEN --> SH_QWEN
C_QWEN --> PY_QWEN
C_QWEN --> PY_BM25
C_QWEN --> PY_LINT

C_QUERY --> PY_BM25
C_QUERY --> PY_SEARCH

C_LINT --> PY_LINT
C_LINT --> PY_BM25

C_GRAPH --> PY_LINT
C_GRAPH --> PY_GRAPH
C_GRAPH --> PY_STATS
C_GRAPH --> PY_WIKI

C_REINDEX --> PY_SNAP

C_JOURNAL --> PY_SEARCH

C_REVIEW --> PY_SEARCH

C_CONVERT -.->|pre-process for| C_INGEST

%% ─────────────────────────────────────────────
%%  HOOK → SCRIPT EDGES
%% ─────────────────────────────────────────────

H_LINT --> PY_LINT
H_BM25 --> PY_BM25
H_GRAPH --> PY_GRAPH

%% ─────────────────────────────────────────────
%%  SCRIPT → DATA WRITES  (solid = writes)
%% ─────────────────────────────────────────────

PY_BM25 --> D_BM25
PY_GRAPH --> D_GRAPH
PY_STATS --> D_STATIC
PY_WIKI --> D_STATIC
PY_SNAP --> D_INDEX

%% ─────────────────────────────────────────────
%%  SCRIPT → DATA READS  (dashed = reads)
%% ─────────────────────────────────────────────

PY_SEARCH -.->|reads| D_BM25
PY_SEARCH -.->|reads| D_MAPS
PY_SEARCH -.->|reads| D_GRAPH
C_LINT -.->|reads| D_GRAPH

%% ─────────────────────────────────────────────
%%  COMMAND → DATA WRITES
%% ─────────────────────────────────────────────

C_INGEST --> D_INDEX
C_INGEST --> D_LOG
C_QAIMPORT --> D_INDEX
C_QAIMPORT --> D_LOG
C_REINDEX --> D_MAPS
C_GRAPH --> D_STATIC

