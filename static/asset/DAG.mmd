classDef command  fill:#4A90D9,stroke:#2C5F8A,color:#fff,rx:6
classDef pyscript fill:#7EC8A4,stroke:#4A8A6A,color:#000,rx:4
classDef shscript fill:#F5A623,stroke:#B87A1A,color:#000,rx:4
classDef hook     fill:#E07070,stroke:#A03030,color:#fff,rx:4
classDef data     fill:#D0C0F0,stroke:#7060A0,color:#000,rx:4
classDef newitem  fill:#FFE066,stroke:#B89A00,color:#000,rx:6

class C_INGEST,C_LOOP,C_QWEN,C_QUERY,C_LINT,C_GRAPH,C_REINDEX,C_CONSOLIDATE,C_CRYSTALLIZE,C_JOURNAL,C_REVIEW,C_QAIMPORT command
class C_CONVERT newitem
class PY_BM25,PY_GRAPH,PY_STATS,PY_WIKI,PY_SNAP,PY_LINT,PY_QWEN pyscript
class PY_SEARCH newitem
class SH_LOOP,SH_QWEN shscript
class H_LINT,H_BM25,H_GRAPH hook
class D_INDEX,D_LOG,D_GRAPH,D_MAPS,D_BM25,D_STATIC data
